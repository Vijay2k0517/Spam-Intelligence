# SMS Spam Classification Engine — Environment Configuration
# Copy this file to .env for local customization

# Application & API Settings
APP_NAME="SMS Spam Classification Engine API"
APP_VERSION="1.0.0"
API_PREFIX="/api/v1"
LOG_LEVEL="INFO"

# Model Selection
DEFAULT_MODEL="hybrid_mnb"

# CORS Allowed Origins (Comma-separated or JSON list for local frontend)
CORS_ORIGINS='["http://localhost:3000", "http://127.0.0.1:3000"]'

# Request & Validation Limits
MAX_MESSAGE_LENGTH=10000
MAX_BATCH_SIZE=100

# Privacy Settings
# Set to true ONLY if message text should be persisted in database history
SAVE_RAW_MESSAGES=false

# SQLite Database Location
# Defaults to backend/data/app.db
DATABASE_FILE="backend/data/app.db"
